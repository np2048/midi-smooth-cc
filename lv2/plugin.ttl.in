# midi-smooth-cc/lv2/plugin.ttl.in

# =============================================================================
# LV2 plugin description for MIDI Smooth CC
#
# Processed by CMake's configure_file() into plugin.ttl inside the bundle
# directory. CMake substitutes @MIDI_SMOOTH_CC_URI@ with
# "urn:midi-smooth-cc:plugin".
#
# This file declares:
#   - The plugin URI and type (lv2:Plugin, lv2:MIDIPlugin, lv2:UtilityPlugin).
#   - Required features (urid:map) and optional features (hardRTCapable).
#   - All 140 ports, with indices 0..139 matching src/plugin.hpp exactly:
#       0     : MIDI Input   (atom:Sequence, InputPort)
#       1     : MIDI Output  (atom:Sequence, OutputPort)
#       2     : enabled
#       3     : smoothing_mode (enumeration: Exponential=0, Slew=1)
#       4     : attack_ms        (1..1000 ms)
#       5     : release_ms       (1..1000 ms)
#       6     : rising_rate      (1..10000 CC/s)
#       7     : falling_rate     (1..10000 CC/s)
#       8     : deadband         (0..10)
#       9     : output_rate_hz   (20..500 Hz)
#       10    : all_cc
#       11    : channel_mask     (0..65535 bitmask, integer)
#       12-139: cc_selection_0 .. cc_selection_127 (128 toggle ports)
#
# All control ports declare lv2:connectionOptional so the host may omit
# any control port; the plugin uses internal defaults for unconnected
# ports (see src/plugin.cpp run()).
# =============================================================================

@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix pprop:  <http://lv2plug.in/ns/ext/port-props#> .

<@MIDI_SMOOTH_CC_URI@>
    a lv2:Plugin ,
      lv2:MIDIPlugin ,
      lv2:UtilityPlugin ;

    doap:name "MIDI Smooth CC" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0-or-later.html> ;
    doap:revision "1.0" ;
    doap:shortdesc "Real-time MIDI CC smoothing for breath controllers and EWI" ;
    doap:description
        """Smoothes noisy, quantized, or rapidly fluctuating MIDI Control Change
values using time-aware exponential filtering or slew-rate limiting. Maintains
independent filter state for every (channel, CC number) pair.""" ;

    # The host MUST pass urid:map so the plugin can resolve midi:MidiEvent.
    lv2:requiredFeature urid:map ;

    # Real-time safety declaration — the host may run run() in the audio thread.
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [

        # -----------------------------------------------------------------
        # Port 0: MIDI Input
        # -----------------------------------------------------------------
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI Input" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;

    ] , [

        # -----------------------------------------------------------------
        # Port 1: MIDI Output
        # -----------------------------------------------------------------
        a lv2:OutputPort, atom:AtomPort ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Output" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;

    ] , [

        # -----------------------------------------------------------------
        # Port 2: enabled (master bypass toggle)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "enabled" ;
        lv2:name "Enabled" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 3: smoothing_mode (enumeration: 0=Exponential, 1=Slew)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "smoothing_mode" ;
        lv2:name "Smoothing Mode" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer ,
                         lv2:enumeration ,
                         lv2:connectionOptional ;
        lv2:scalePoint [
            rdfs:label "Exponential" ;
            rdf:value 0.0 ;
        ] , [
            rdfs:label "Slew" ;
            rdf:value 1.0 ;
        ] ;

    ] , [

        # -----------------------------------------------------------------
        # Port 4: attack_ms (1..1000 ms)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "attack_ms" ;
        lv2:name "Attack" ;
        lv2:default 50.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 1000.0 ;
        lv2:portProperty lv2:connectionOptional ;
        units:unit units:ms ;

    ] , [

        # -----------------------------------------------------------------
        # Port 5: release_ms (1..1000 ms)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "release_ms" ;
        lv2:name "Release" ;
        lv2:default 100.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 1000.0 ;
        lv2:portProperty lv2:connectionOptional ;
        units:unit units:ms ;

    ] , [

        # -----------------------------------------------------------------
        # Port 6: rising_rate (1..10000 CC/s)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "rising_rate" ;
        lv2:name "Rising Rate" ;
        lv2:default 500.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 7: falling_rate (1..10000 CC/s)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "falling_rate" ;
        lv2:name "Falling Rate" ;
        lv2:default 500.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 8: deadband (0..10 CC units)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "deadband" ;
        lv2:name "Deadband" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 9: output_rate_hz (20..500 Hz)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "output_rate_hz" ;
        lv2:name "Output Rate" ;
        lv2:default 100.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 500.0 ;
        lv2:portProperty lv2:connectionOptional ;
        units:unit units:Hz ;

    ] , [

        # -----------------------------------------------------------------
        # Port 10: all_cc (process all CC numbers, with exclusions)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "all_cc" ;
        lv2:name "All CC" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 11: channel_mask (16-bit bitmask, integer)
        # Bit i selects channel i+1. Default 65535 = 0xFFFF = all channels.
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "channel_mask" ;
        lv2:name "Channel Mask" ;
        lv2:default 65535.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 65535.0 ;
        lv2:portProperty lv2:integer ,
                         lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Ports 12..139: cc_selection_0 .. cc_selection_127
        #
        # 128 individual toggle ports, one per MIDI CC number.
        # Default is 0 (disabled) for all, EXCEPT cc_selection_7 (port
        # index 19) which defaults to 1 (enabled), matching spec §12.
        #
        # In all_cc=false mode (whitelist): cc_selection[i]==true means
        #   "process CC number i".
        # In all_cc=true  mode (blacklist): cc_selection[i]==true means
        #   "exclude CC number i".
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "cc_selection_0" ;
        lv2:name "CC Selection 0" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "cc_selection_1" ; lv2:name "CC Selection 1" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 14 ; lv2:symbol "cc_selection_2" ; lv2:name "CC Selection 2" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 15 ; lv2:symbol "cc_selection_3" ; lv2:name "CC Selection 3" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 16 ; lv2:symbol "cc_selection_4" ; lv2:name "CC Selection 4" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 17 ; lv2:symbol "cc_selection_5" ; lv2:name "CC Selection 5" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 18 ; lv2:symbol "cc_selection_6" ; lv2:name "CC Selection 6" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 19 ; lv2:symbol "cc_selection_7" ; lv2:name "CC Selection 7" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 20 ; lv2:symbol "cc_selection_8" ; lv2:name "CC Selection 8" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 21 ; lv2:symbol "cc_selection_9" ; lv2:name "CC Selection 9" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 22 ; lv2:symbol "cc_selection_10" ; lv2:name "CC Selection 10" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 23 ; lv2:symbol "cc_selection_11" ; lv2:name "CC Selection 11" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 24 ; lv2:symbol "cc_selection_12" ; lv2:name "CC Selection 12" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 25 ; lv2:symbol "cc_selection_13" ; lv2:name "CC Selection 13" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 26 ; lv2:symbol "cc_selection_14" ; lv2:name "CC Selection 14" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 27 ; lv2:symbol "cc_selection_15" ; lv2:name "CC Selection 15" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 28 ; lv2:symbol "cc_selection_16" ; lv2:name "CC Selection 16" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 29 ; lv2:symbol "cc_selection_17" ; lv2:name "CC Selection 17" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 30 ; lv2:symbol "cc_selection_18" ; lv2:name "CC Selection 18" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 31 ; lv2:symbol "cc_selection_19" ; lv2:name "CC Selection 19" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 32 ; lv2:symbol "cc_selection_20" ; lv2:name "CC Selection 20" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 33 ; lv2:symbol "cc_selection_21" ; lv2:name "CC Selection 21" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 34 ; lv2:symbol "cc_selection_22" ; lv2:name "CC Selection 22" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 35 ; lv2:symbol "cc_selection_23" ; lv2:name "CC Selection 23" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 36 ; lv2:symbol "cc_selection_24" ; lv2:name "CC Selection 24" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 37 ; lv2:symbol "cc_selection_25" ; lv2:name "CC Selection 25" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 38 ; lv2:symbol "cc_selection_26" ; lv2:name "CC Selection 26" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 39 ; lv2:symbol "cc_selection_27" ; lv2:name "CC Selection 27" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 40 ; lv2:symbol "cc_selection_28" ; lv2:name "CC Selection 28" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 41 ; lv2:symbol "cc_selection_29" ; lv2:name "CC Selection 29" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 42 ; lv2:symbol "cc_selection_30" ; lv2:name "CC Selection 30" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 43 ; lv2:symbol "cc_selection_31" ; lv2:name "CC Selection 31" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 44 ; lv2:symbol "cc_selection_32" ; lv2:name "CC Selection 32" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 45 ; lv2:symbol "cc_selection_33" ; lv2:name "CC Selection 33" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 46 ; lv2:symbol "cc_selection_34" ; lv2:name "CC Selection 34" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 47 ; lv2:symbol "cc_selection_35" ; lv2:name "CC Selection 35" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 48 ; lv2:symbol "cc_selection_36" ; lv2:name "CC Selection 36" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 49 ; lv2:symbol "cc_selection_37" ; lv2:name "CC Selection 37" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 50 ; lv2:symbol "cc_selection_38" ; lv2:name "CC Selection 38" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 51 ; lv2:symbol "cc_selection_39" ; lv2:name "CC Selection 39" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 52 ; lv2:symbol "cc_selection_40" ; lv2:name "CC Selection 40" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 53 ; lv2:symbol "cc_selection_41" ; lv2:name "CC Selection 41" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 54 ; lv2:symbol "cc_selection_42" ; lv2:name "CC Selection 42" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 55 ; lv2:symbol "cc_selection_43" ; lv2:name "CC Selection 43" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 56 ; lv2:symbol "cc_selection_44" ; lv2:name "CC Selection 44" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 57 ; lv2:symbol "cc_selection_45" ; lv2:name "CC Selection 45" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 58 ; lv2:symbol "cc_selection_46" ; lv2:name "CC Selection 46" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 59 ; lv2:symbol "cc_selection_47" ; lv2:name "CC Selection 47" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 60 ; lv2:symbol "cc_selection_48" ; lv2:name "CC Selection 48" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
