# midi-smooth-cc/lv2/plugin.ttl.in

# =============================================================================
# LV2 plugin description for MIDI Smooth CC
#
# Processed by CMake's configure_file() into plugin.ttl inside the bundle
# directory. CMake substitutes @MIDI_SMOOTH_CC_URI@ with
# "urn:midi-smooth-cc:plugin".
#
# This file declares:
#   - The plugin URI and type (lv2:Plugin, lv2:MIDIPlugin, lv2:UtilityPlugin).
#   - Required features (urid:map) and optional features (hardRTCapable).
#   - All 140 ports, with indices 0..139 matching src/plugin.hpp exactly:
#       0     : MIDI Input   (atom:Sequence, InputPort)
#       1     : MIDI Output  (atom:Sequence, OutputPort)
#       2     : enabled / bypass (lv2:toggled)
#       3     : smoothing_mode (enumeration: Exponential=0, Slew=1)
#       4     : attack_ms        (1..1000 ms)
#       5     : release_ms       (1..1000 ms)
#       6     : rising_rate      (1..10000 CC/s)
#       7     : falling_rate     (1..10000 CC/s)
#       8     : deadband         (0..20)
#       9     : output_rate_hz   (10..500 Hz)
#       10    : all_cc           (lv2:toggled boolean: 0=whitelist, 1=all)
#       11    : channel_mask     (0..65535 bitmask, integer)
#       12-139: cc_selection_0 .. cc_selection_127 (128 lv2:toggled booleans)
#               Each port's lv2:name uses the descriptive MIDI-spec label
#               for its CC number (e.g. port 19 / CC 7 = "Volume - CC 7").
#               Port index N (12..139) corresponds to CC number N-12.
#               The lv2:symbol "cc_selection_N" is preserved unchanged for
#               preset/state compatibility; only the human-readable
#               lv2:name is descriptive.
#
# All control ports declare lv2:connectionOptional so the host may omit
# any control port; the plugin uses internal defaults for unconnected
# ports (see src/plugin.cpp run()).
# =============================================================================

@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix pprop:  <http://lv2plug.in/ns/ext/port-props#> .

<@MIDI_SMOOTH_CC_URI@>
    a lv2:Plugin ,
      lv2:MIDIPlugin ,
      lv2:UtilityPlugin ;

    doap:name "MIDI Smooth CC" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0-or-later.html> ;
    doap:revision "1.0" ;
    doap:shortdesc "Real-time MIDI CC smoothing for breath controllers and EWI" ;
    doap:description
        """Smoothes noisy, quantized, or rapidly fluctuating MIDI Control Change
values using time-aware exponential filtering or slew-rate limiting. Maintains
independent filter state for every (channel, CC number) pair.""" ;

    # The host MUST pass urid:map so the plugin can resolve midi:MidiEvent.
    lv2:requiredFeature urid:map ;

    # Real-time safety declaration — the host may run run() in the audio thread.
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [

        # -----------------------------------------------------------------
        # Port 0: MIDI Input
        # -----------------------------------------------------------------
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI Input" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;

    ] , [

        # -----------------------------------------------------------------
        # Port 1: MIDI Output
        # -----------------------------------------------------------------
        a lv2:OutputPort, atom:AtomPort ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Output" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;

    ] , [

        # -----------------------------------------------------------------
        # Port 2: enabled / bypass (master bypass toggle)
        #
        # Declared lv2:toggled so LV2 hosts render this as a binary On/Off
        # switch or checkbox rather than a continuous float slider. The
        # C++ processing logic in src/plugin.cpp already interprets the
        # value as a boolean threshold (value > 0.5f = ON), so this is
        # purely a UI-hint metadata change. Range stays 0.0..1.0.
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "enabled" ;
        lv2:name "Enabled / Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ,
                         lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 3: smoothing_mode (enumeration: 0=Exponential, 1=Slew)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "smoothing_mode" ;
        lv2:name "Smoothing Mode" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer ,
                         lv2:enumeration ,
                         lv2:connectionOptional ;
        lv2:scalePoint [
            rdfs:label "Exponential" ;
            rdf:value 0.0 ;
        ] , [
            rdfs:label "Slew" ;
            rdf:value 1.0 ;
        ] ;

    ] , [

        # -----------------------------------------------------------------
        # Port 4: attack_ms (1..1000 ms)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "attack_ms" ;
        lv2:name "Attack" ;
        lv2:default 30.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 1000.0 ;
        lv2:portProperty lv2:connectionOptional ;
        units:unit units:ms ;

    ] , [

        # -----------------------------------------------------------------
        # Port 5: release_ms (1..1000 ms)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "release_ms" ;
        lv2:name "Release" ;
        lv2:default 25.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 1000.0 ;
        lv2:portProperty lv2:connectionOptional ;
        units:unit units:ms ;

    ] , [

        # -----------------------------------------------------------------
        # Port 6: rising_rate (1..10000 CC/s)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "rising_rate" ;
        lv2:name "Rising Rate" ;
        lv2:default 200.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 7: falling_rate (1..10000 CC/s)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "falling_rate" ;
        lv2:name "Falling Rate" ;
        lv2:default 500.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 8: deadband (0..20 CC units)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "deadband" ;
        lv2:name "Deadband" ;
        lv2:default 5.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 20.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 9: output_rate_hz (10..500 Hz)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "output_rate_hz" ;
        lv2:name "Output Rate" ;
        lv2:default 250.0 ;
        lv2:minimum 10.0 ;
        lv2:maximum 500.0 ;
        lv2:portProperty lv2:connectionOptional ;
        units:unit units:Hz ;

    ] , [

        # -----------------------------------------------------------------
        # Port 10: all_cc (boolean toggle: process all CC numbers)
        #
        # Declared lv2:toggled so LV2 hosts render this as a checkbox or
        # toggle button rather than a continuous float slider. The value
        # is interpreted as a boolean (value > 0.5f = true) by
        # src/plugin.cpp run().
        #
        # When false (0.0): cc_selection acts as a whitelist — only CC
        #   numbers with cc_selection[i]==true are processed.
        # When true (1.0): cc_selection acts as a blacklist — all CC
        #   numbers are processed EXCEPT those with cc_selection[i]==true.
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "all_cc" ;
        lv2:name "All CC" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ,
                         lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 11: channel_mask (16-bit bitmask, integer)
        # Bit i selects channel i+1. Default 65535 = 0xFFFF = all channels.
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "channel_mask" ;
        lv2:name "Channel Mask" ;
        lv2:default 65535.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 65535.0 ;
        lv2:portProperty lv2:integer ,
                         lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Ports 12..139: cc_selection_0 .. cc_selection_127
        #
        # 128 individual toggle ports, one per MIDI CC number. Each is
        # declared lv2:toggled so LV2 hosts render them as checkboxes or
        # toggle buttons rather than continuous float sliders. The C++
        # processing logic interprets each value as a boolean threshold
        # (value > 0.5f = true).
        #
        # Port index N (12..139) corresponds to MIDI CC number N-12.
        # The lv2:symbol "cc_selection_N" is preserved unchanged for
        # preset/state compatibility. Only the human-readable lv2:name
        # is descriptive, using the standard MIDI CC name followed by
        # the CC number (e.g. "Volume - CC 7"). Unnamed controllers
        # use the bare label "CC N".
        #
        # Default is 0.0 (disabled) for all, EXCEPT cc_selection_7
        # (port index 19, CC 7 = "Volume") which defaults to 1.0
        # (enabled), matching spec §12.
        #
        # In all_cc=false mode (whitelist): cc_selection[i]==true means
        #   "process CC number i".
        # In all_cc=true  mode (blacklist): cc_selection[i]==true means
        #   "exclude CC number i".
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "cc_selection_0" ;
        lv2:name "Bank Select - CC 0" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:connectionOptional ;

    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "cc_selection_1" ; lv2:name "Modulation - CC 1" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 14 ; lv2:symbol "cc_selection_2" ; lv2:name "Breath Controller - CC 2" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 15 ; lv2:symbol "cc_selection_3" ; lv2:name "CC 3" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 16 ; lv2:symbol "cc_selection_4" ; lv2:name "Foot Controller - CC 4" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 17 ; lv2:symbol "cc_selection_5" ; lv2:name "Portamento Time - CC 5" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 18 ; lv2:symbol "cc_selection_6" ; lv2:name "Data Entry MSB - CC 6" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 19 ; lv2:symbol "cc_selection_7" ; lv2:name "Volume - CC 7" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 20 ; lv2:symbol "cc_selection_8" ; lv2:name "Balance - CC 8" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 21 ; lv2:symbol "cc_selection_9" ; lv2:name "CC 9" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 22 ; lv2:symbol "cc_selection_10" ; lv2:name "Pan - CC 10" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 23 ; lv2:symbol "cc_selection_11" ; lv2:name "Expression - CC 11" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 24 ; lv2:symbol "cc_selection_12" ; lv2:name "Effect Control 1 - CC 12" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 25 ; lv2:symbol "cc_selection_13" ; lv2:name "Effect Control 2 - CC 13" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 26 ; lv2:symbol "cc_selection_14" ; lv2:name "CC 14" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 27 ; lv2:symbol "cc_selection_15" ; lv2:name "CC 15" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 28 ; lv2:symbol "cc_selection_16" ; lv2:name "GP Controller 1 - CC 16" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 29 ; lv2:symbol "cc_selection_17" ; lv2:name "GP Controller 2 - CC 17" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 30 ; lv2:symbol "cc_selection_18" ; lv2:name "GP Controller 3 - CC 18" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 31 ; lv2:symbol "cc_selection_19" ; lv2:name "GP Controller 4 - CC 19" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 32 ; lv2:symbol "cc_selection_20" ; lv2:name "CC 20" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 33 ; lv2:symbol "cc_selection_21" ; lv2:name "CC 21" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 34 ; lv2:symbol "cc_selection_22" ; lv2:name "CC 22" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 35 ; lv2:symbol "cc_selection_23" ; lv2:name "CC 23" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 36 ; lv2:symbol "cc_selection_24" ; lv2:name "CC 24" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 37 ; lv2:symbol "cc_selection_25" ; lv2:name "CC 25" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 38 ; lv2:symbol "cc_selection_26" ; lv2:name "CC 26" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 39 ; lv2:symbol "cc_selection_27" ; lv2:name "CC 27" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 40 ; lv2:symbol "cc_selection_28" ; lv2:name "CC 28" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 41 ; lv2:symbol "cc_selection_29" ; lv2:name "CC 29" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 42 ; lv2:symbol "cc_selection_30" ; lv2:name "CC 30" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 43 ; lv2:symbol "cc_selection_31" ; lv2:name "CC 31" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 44 ; lv2:symbol "cc_selection_32" ; lv2:name "Bank Select LSB - CC 32" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 45 ; lv2:symbol "cc_selection_33" ; lv2:name "Modulation LSB - CC 33" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 46 ; lv2:symbol "cc_selection_34" ; lv2:name "Breath Controller LSB - CC 34" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 47 ; lv2:symbol "cc_selection_35" ; lv2:name "CC 35" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 48 ; lv2:symbol "cc_selection_36" ; lv2:name "Foot Controller LSB - CC 36" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 49 ; lv2:symbol "cc_selection_37" ; lv2:name "Portamento Time LSB - CC 37" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 50 ; lv2:symbol "cc_selection_38" ; lv2:name "Data Entry LSB - CC 38" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 51 ; lv2:symbol "cc_selection_39" ; lv2:name "Volume LSB - CC 39" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 52 ; lv2:symbol "cc_selection_40" ; lv2:name "Balance LSB - CC 40" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 53 ; lv2:symbol "cc_selection_41" ; lv2:name "CC 41" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 54 ; lv2:symbol "cc_selection_42" ; lv2:name "Pan LSB - CC 42" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
