# midi-smooth-cc/lv2/plugin.ttl.in

# =============================================================================
# LV2 plugin description for MIDI Smooth CC
#
# Processed by CMake's configure_file() into plugin.ttl inside the bundle
# directory. CMake substitutes @MIDI_SMOOTH_CC_URI@ with
# "urn:midi-smooth-cc:plugin".
#
# Port layout (156 ports total, indices 0..155):
#   0       : MIDI Input   (atom:Sequence, InputPort)
#   1       : MIDI Output  (atom:Sequence, OutputPort)
#   2       : enabled / bypass (lv2:toggled)
#   3       : smoothing_mode (enumeration: Exponential=0, Slew=1)
#   4       : attack_ms        (1..1000 ms)
#   5       : release_ms       (1..1000 ms)
#   6       : rising_rate      (1..10000 CC/s)
#   7       : falling_rate     (1..10000 CC/s)
#   8       : deadband         (0..20)
#   9       : output_rate_hz   (10..500 Hz)
#   10      : all_cc           (lv2:toggled: 0=whitelist, 1=all CCs)
#   11      : all_channels     (lv2:toggled: 0=whitelist, 1=all channels)
#   12..27  : channel_1 .. channel_16 (16 lv2:toggled booleans)
#             Port index 12+i corresponds to MIDI channel i+1.
#             Default 1.0 (all on) to preserve previous channel_mask=0xFFFF.
#   28..155 : cc_selection_0 .. cc_selection_127 (128 lv2:toggled booleans)
#             Each port's lv2:name uses the descriptive MIDI-spec label.
#             Port index 28+i corresponds to CC number i.
#             Default 0.0 for all except cc_selection_7 (port 35) = 1.0.
#
# All control ports declare lv2:connectionOptional so the host may omit
# any control port; the plugin uses internal defaults for unconnected
# ports (see src/plugin.cpp run()).
# =============================================================================

@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .
@prefix pprop:  <http://lv2plug.in/ns/ext/port-props#> .

<@MIDI_SMOOTH_CC_URI@>
    a lv2:Plugin ,
      lv2:MIDIPlugin ,
      lv2:UtilityPlugin ;

    doap:name "MIDI Smooth CC" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0-or-later.html> ;
    doap:revision "1.0" ;
    doap:shortdesc "Real-time MIDI CC smoothing for breath controllers and EWI" ;
    doap:description
        """Smoothes noisy, quantized, or rapidly fluctuating MIDI Control Change
values using time-aware exponential filtering or slew-rate limiting. Maintains
independent filter state for every (channel, CC number) pair.""" ;

    # The host MUST pass urid:map so the plugin can resolve midi:MidiEvent.
    lv2:requiredFeature urid:map ;

    # Real-time safety declaration — the host may run run() in the audio thread.
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [

        # -----------------------------------------------------------------
        # Port 0: MIDI Input
        # -----------------------------------------------------------------
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI Input" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;

    ] , [

        # -----------------------------------------------------------------
        # Port 1: MIDI Output
        # -----------------------------------------------------------------
        a lv2:OutputPort, atom:AtomPort ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Output" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;

    ] , [

        # -----------------------------------------------------------------
        # Port 2: enabled / bypass (master bypass toggle)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "enabled" ;
        lv2:name "Enabled / Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ,
                         lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 3: smoothing_mode (enumeration: 0=Exponential, 1=Slew)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "smoothing_mode" ;
        lv2:name "Smoothing Mode" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:integer ,
                         lv2:enumeration ,
                         lv2:connectionOptional ;
        lv2:scalePoint [
            rdfs:label "Exponential" ;
            rdf:value 0.0 ;
        ] , [
            rdfs:label "Slew" ;
            rdf:value 1.0 ;
        ] ;

    ] , [

        # -----------------------------------------------------------------
        # Port 4: attack_ms (1..1000 ms)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "attack_ms" ;
        lv2:name "Attack" ;
        lv2:default 30.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 1000.0 ;
        lv2:portProperty lv2:connectionOptional ;
        units:unit units:ms ;

    ] , [

        # -----------------------------------------------------------------
        # Port 5: release_ms (1..1000 ms)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "release_ms" ;
        lv2:name "Release" ;
        lv2:default 25.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 1000.0 ;
        lv2:portProperty lv2:connectionOptional ;
        units:unit units:ms ;

    ] , [

        # -----------------------------------------------------------------
        # Port 6: rising_rate (1..10000 CC/s)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "rising_rate" ;
        lv2:name "Rising Rate" ;
        lv2:default 200.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 7: falling_rate (1..10000 CC/s)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "falling_rate" ;
        lv2:name "Falling Rate" ;
        lv2:default 500.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 8: deadband (0..20 CC units)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "deadband" ;
        lv2:name "Deadband" ;
        lv2:default 5.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 20.0 ;
        lv2:portProperty lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 9: output_rate_hz (10..500 Hz)
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "output_rate_hz" ;
        lv2:name "Output Rate" ;
        lv2:default 250.0 ;
        lv2:minimum 10.0 ;
        lv2:maximum 500.0 ;
        lv2:portProperty lv2:connectionOptional ;
        units:unit units:Hz ;

    ] , [

        # -----------------------------------------------------------------
        # Port 10: all_cc (boolean toggle: process all CC numbers)
        #
        # Declared lv2:toggled so LV2 hosts render this as a checkbox.
        # When false (0.0, default): cc_selection is a whitelist.
        # When true (1.0): cc_selection is a blacklist.
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "all_cc" ;
        lv2:name "All CC" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ,
                         lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Port 11: all_channels (boolean toggle: process all MIDI channels)
        #
        # Mirrors the all_cc / cc_selection semantics for MIDI channels.
        # When false (0.0, default): channel_selection is a whitelist —
        #   only channels with channel_selection[i]==true are processed.
        # When true (1.0): channel_selection is a blacklist — all channels
        #   are processed EXCEPT those with channel_selection[i]==true.
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "all_channels" ;
        lv2:name "All Channels" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ,
                         lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Ports 12..27: channel_1 .. channel_16
        #
        # 16 individual toggle ports, one per MIDI channel. Port index
        # 12+i corresponds to MIDI channel i+1 (user-facing numbering).
        # Each is declared lv2:toggled so hosts render them as checkboxes.
        #
        # Default 1.0 (enabled) for all 16, preserving the previous
        # channel_mask=0xFFFF default behavior.
        #
        # In all_channels=false mode (whitelist): channel_selection[i]==true
        #   means "process channel i+1".
        # In all_channels=true  mode (blacklist): channel_selection[i]==true
        #   means "exclude channel i+1".
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "channel_1" ;
        lv2:name "Channel 1" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:connectionOptional ;

    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "channel_2" ; lv2:name "Channel 2" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 14 ; lv2:symbol "channel_3" ; lv2:name "Channel 3" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 15 ; lv2:symbol "channel_4" ; lv2:name "Channel 4" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 16 ; lv2:symbol "channel_5" ; lv2:name "Channel 5" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 17 ; lv2:symbol "channel_6" ; lv2:name "Channel 6" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 18 ; lv2:symbol "channel_7" ; lv2:name "Channel 7" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 19 ; lv2:symbol "channel_8" ; lv2:name "Channel 8" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 20 ; lv2:symbol "channel_9" ; lv2:name "Channel 9" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 21 ; lv2:symbol "channel_10" ; lv2:name "Channel 10" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 22 ; lv2:symbol "channel_11" ; lv2:name "Channel 11" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 23 ; lv2:symbol "channel_12" ; lv2:name "Channel 12" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 24 ; lv2:symbol "channel_13" ; lv2:name "Channel 13" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 25 ; lv2:symbol "channel_14" ; lv2:name "Channel 14" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 26 ; lv2:symbol "channel_15" ; lv2:name "Channel 15" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 27 ; lv2:symbol "channel_16" ; lv2:name "Channel 16" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;

    ] , [

        # -----------------------------------------------------------------
        # Ports 28..155: cc_selection_0 .. cc_selection_127
        #
        # 128 individual toggle ports, one per MIDI CC number. Each is
        # declared lv2:toggled. Port index 28+i corresponds to CC number i.
        # The lv2:symbol "cc_selection_N" is preserved for preset/state
        # compatibility. The lv2:name uses the descriptive MIDI-spec label.
        #
        # Default 0.0 for all, EXCEPT cc_selection_7 (port 35, CC 7 =
        # "Volume") which defaults to 1.0, matching spec §12.
        # -----------------------------------------------------------------
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 28 ;
        lv2:symbol "cc_selection_0" ;
        lv2:name "Bank Select - CC 0" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:connectionOptional ;

    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 29 ; lv2:symbol "cc_selection_1" ; lv2:name "Modulation - CC 1" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 30 ; lv2:symbol "cc_selection_2" ; lv2:name "Breath Controller - CC 2" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 31 ; lv2:symbol "cc_selection_3" ; lv2:name "CC 3" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 32 ; lv2:symbol "cc_selection_4" ; lv2:name "Foot Controller - CC 4" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 33 ; lv2:symbol "cc_selection_5" ; lv2:name "Portamento Time - CC 5" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 34 ; lv2:symbol "cc_selection_6" ; lv2:name "Data Entry MSB - CC 6" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 35 ; lv2:symbol "cc_selection_7" ; lv2:name "Volume - CC 7" ; lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 36 ; lv2:symbol "cc_selection_8" ; lv2:name "Balance - CC 8" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 37 ; lv2:symbol "cc_selection_9" ; lv2:name "CC 9" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 38 ; lv2:symbol "cc_selection_10" ; lv2:name "Pan - CC 10" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 39 ; lv2:symbol "cc_selection_11" ; lv2:name "Expression - CC 11" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 40 ; lv2:symbol "cc_selection_12" ; lv2:name "Effect Control 1 - CC 12" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 41 ; lv2:symbol "cc_selection_13" ; lv2:name "Effect Control 2 - CC 13" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 42 ; lv2:symbol "cc_selection_14" ; lv2:name "CC 14" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 43 ; lv2:symbol "cc_selection_15" ; lv2:name "CC 15" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 44 ; lv2:symbol "cc_selection_16" ; lv2:name "GP Controller 1 - CC 16" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 45 ; lv2:symbol "cc_selection_17" ; lv2:name "GP Controller 2 - CC 17" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 46 ; lv2:symbol "cc_selection_18" ; lv2:name "GP Controller 3 - CC 18" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 47 ; lv2:symbol "cc_selection_19" ; lv2:name "GP Controller 4 - CC 19" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 48 ; lv2:symbol "cc_selection_20" ; lv2:name "CC 20" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 49 ; lv2:symbol "cc_selection_21" ; lv2:name "CC 21" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 50 ; lv2:symbol "cc_selection_22" ; lv2:name "CC 22" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 51 ; lv2:symbol "cc_selection_23" ; lv2:name "CC 23" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 52 ; lv2:symbol "cc_selection_24" ; lv2:name "CC 24" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 53 ; lv2:symbol "cc_selection_25" ; lv2:name "CC 25" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 54 ; lv2:symbol "cc_selection_26" ; lv2:name "CC 26" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 55 ; lv2:symbol "cc_selection_27" ; lv2:name "CC 27" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 56 ; lv2:symbol "cc_selection_28" ; lv2:name "CC 28" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled , lv2:connectionOptional ;
    ] , [
