    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 65 ; lv2:symbol "cc_selection_53" ; lv2:name "CC Selection 53" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:connectionOptional ;
    ] , [
